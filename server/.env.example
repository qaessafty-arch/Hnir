# ---- Darwaza School Management System — environment configuration ----
# Copy to .env (never commit .env). All secrets must come from the environment / secret manager.

NODE_ENV=production            # development | test | staging | production
PORT=3000
WEB_CONCURRENCY=2           # worker processes (≈ CPU cores); DB_POOL_MAX applies per worker

# PostgreSQL connection (use a dedicated least-privilege role; require TLS in production)
DATABASE_URL=postgres://darwaza_app:CHANGE_ME@db.internal:5432/darwaza?sslmode=require
DB_POOL_MAX=20

# 32+ random characters, e.g. `openssl rand -base64 48`. Encrypts MFA secrets at rest.
# Losing/changing this key invalidates all enrolled MFA devices.
APP_ENCRYPTION_KEY=

# Public origin of the site, used for the CSRF Origin check.
PUBLIC_ORIGIN=https://grades.example.school

# Number of reverse proxies in front of the app (for correct client IPs / rate limiting)
TRUST_PROXY=1
COOKIE_SECURE=true

# Where student photos are stored (outside the web root, include it in backups)
UPLOAD_DIR=/var/lib/darwaza/uploads

# Where scripts/backup.sh writes encrypted backups (shown read-only in the admin UI)
BACKUP_DIR=/var/backups/darwaza
# Backup passphrase is read by scripts/backup.sh only — store it in a secret manager.
# BACKUP_PASSPHRASE=

LOG_LEVEL=info
LOGIN_RATE_LIMIT=300
MIGRATE_ON_START=true
